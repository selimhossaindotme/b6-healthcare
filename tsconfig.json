{
  "compilerOptions": {
    "module": "preserve",                                
    "rootDir": "./src",
    "outDir": "./dist",  
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "prisma.config.ts",
    "migrations"
  ]
}