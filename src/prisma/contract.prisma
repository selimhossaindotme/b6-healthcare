// use prisma-8

model Specialty {
  id String @id @onCreate(uuid())
  title String @unique
  description String?
  icon String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @onUpdate(now())
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  @@index([deletedAt], name: "specialty_deleted_at_index")
  @@index([title, deletedAt], name: "specialty_title_deleted_at_index")
  @@map("specialties")
}